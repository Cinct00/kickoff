{
  "description": "ai-toolkit local-first hooks (Claude Code format). Copilot uses copilot-hooks.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/local_first.py\" --format claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
